<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ProgressBar?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.PrimaryController">
<children>
      <Label text="Fabulas graficas de Esopo" />
      <Label text="La Liebre y la Tortuga" />
      <Label fx:id="lblLiebre" text="La Liebre: Esperando!"/>
      <ProgressBar fx:id="progressBarLiebre" progress="0.0" prefWidth="300.0" /> 
      <Label fx:id="lblTortuga" text="La Tortuga: Esperando!" />
      <ProgressBar fx:id="progressBarTortuga" progress="0.0" prefWidth="300.0" /> 
      <Button fx:id="btnIniciar" text="¡Iniciar Carrera!" onAction="#btnIniciarCarrera_click"/>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
