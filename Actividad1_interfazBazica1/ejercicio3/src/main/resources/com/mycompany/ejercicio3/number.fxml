<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="12" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ejercicio3.NumberController">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
    <HBox spacing="10">
        <Label text="Ingrese un número"/>
        <TextField fx:id="txtNumero"/>
        <Button text="Analizar" onAction="#analizar"/>
        <Button text="Limpiar" onAction="#limpiar"/>
    </HBox>
    <GridPane hgap="20" vgap="8">
        <Label text="Cantidad de cifras" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtCantidad" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Suma de cifras impares" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtImpares" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Suma de cifras pares" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="txtPares" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label text="Suma total de cifras" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="txtSuma" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Label text="Cifra mayor" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <TextField fx:id="txtMayor" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        <Label text="Cifra menor" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <TextField fx:id="txtMenor" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
        <Label text="Divisores" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <TextArea fx:id="txtDivisores" editable="false" prefHeight="180" prefWidth="150" GridPane.columnIndex="2" GridPane.rowIndex="1" GridPane.rowSpan="5"/>
    </GridPane>
</VBox>