<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="12" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ejercicio4.TableController">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
    <HBox spacing="10">
        <Label text="Tabla del:"/>
        <TextField fx:id="txtNumero"/>
        <Button text="Calcular" onAction="#calcular"/>
        <Button text="Limpiar" onAction="#limpiar"/>
    </HBox>
    <TextArea fx:id="txtResultado" editable="false" prefHeight="220" prefWidth="250"/>
</VBox>