<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="12" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ejercicio5.ExpensesController">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
    <GridPane hgap="20" vgap="10">
        <Label text="Alimentación" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtAlimentacion" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Estadísticas" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <Label text="Refrigerios" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtRefrigerios" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Total semanal" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <TextField fx:id="txtTotal" editable="false" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
        <Label text="Transporte" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="txtTransporte" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label text="Gasto más alto" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
        <TextField fx:id="txtMayor" editable="false" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
        <Label text="Telefonía" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="txtTelefonia" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Label text="Otros" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <TextField fx:id="txtOtros" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
    </GridPane>
    <HBox spacing="10">
        <Button text="Calcular estadísticas" onAction="#calcular"/>
        <Button text="Limpiar" onAction="#limpiar"/>
    </HBox>
</VBox>